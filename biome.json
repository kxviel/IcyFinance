{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"enabled": true
	},
	"files": {
		"includes": ["**", "!src/routeTree.gen.ts"]
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"correctness": {
				"noUnusedImports": {
					"level": "error",
					"fix": "safe"
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["public/favicon.svg"],
			"linter": {
				"enabled": false
			}
		}
	],
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
